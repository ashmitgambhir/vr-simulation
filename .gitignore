# ---------------------------------------------------------------------------
# Unity generated / derived output.
# Everything here is reproducible from source and must never be committed.
# ---------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity3D generated meta files for auto-generated folders
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated crash / profiler artefacts
sysinfo.txt
crashlytics-build.properties
*.unityperf
/[Aa]ssets/[Aa]ssetStoreTools*

# ---------------------------------------------------------------------------
# IDE / tooling
# Solution and project files are regenerated by Unity on every import.
# ---------------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.booproj
*.svd
*.pidb
*.opendb
*.VC.db

# ---------------------------------------------------------------------------
# Build artefacts for the Meta Quest (Android) target
# ---------------------------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.app

# ---------------------------------------------------------------------------
# Operating system noise
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Deliberately NOT ignored — these are required for a reproducible project:
#
#   *.meta                       Asset GUIDs. Losing these breaks every scene
#                                and prefab reference in the project.
#   Packages/packages-lock.json  Pins the exact resolved package graph so that
#                                every machine and CI runner builds the same
#                                dependency set (TRD 3, TRD 24).
#   ProjectSettings/             XR, quality, graphics and player configuration
#                                for the Quest target.
# ---------------------------------------------------------------------------
